# App mode: set to "true" to skip auth and use mock user
LOCAL_MODE=true

# Backend
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173
SCAN_FUNCTION_APP_URL=http://functions:80
SCAN_FUNCTION_KEY=local-dev-function-key

# Entra ID (multi-tenant app registration)
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_TENANT_ID=your-tenant-id

# Microsoft Graph API version ("beta" for latest features, "v1.0" for GA stability)
GRAPH_API_VERSION=beta

# Cosmos DB (emulator well-known key — used automatically by docker-compose)
COSMOS_ENDPOINT=https://localhost:8081
COSMOS_KEY=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw==
COSMOS_MASTER_DATABASE=entra-master

# Optional for local Functions + Azurite (docker-compose sets a default value)
AZURE_WEBJOBS_STORAGE=

# Azure Cache for Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

# Azure Key Vault
KEYVAULT_URL=https://your-vault.vault.azure.net

# Microsoft Foundry (AI narratives)
AZURE_FOUNDRY_ENDPOINT=https://your-foundry.openai.azure.com
AZURE_FOUNDRY_KEY=your-foundry-key
AZURE_FOUNDRY_MODEL=gpt-4o

# PIM Privileged Session Tracking
PIM_SESSION_ENABLED=true
PIM_SESSION_POLL_INTERVAL_MINUTES=15
PIM_SESSION_BACKFILL_DAYS=30
PIM_SESSION_BUSINESS_HOURS_START=7
PIM_SESSION_BUSINESS_HOURS_END=19

# Graph API App Registration (for project scans — separate from backend auth)
# Needs: AuditLog.Read.All, Directory.Read.All, Application.Read.All,
#         RoleManagement.Read.Directory, RoleManagement.Read.All, Policy.Read.All,
#         User.Read.All, GroupMember.Read.All
GRAPH_APP_CLIENT_ID=
GRAPH_APP_CLIENT_SECRET=
GRAPH_APP_TENANT_ID=your-target-tenant-id
GRAPH_APP_TENANT_NAME=Your Tenant Name

# Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Frontend
VITE_APP_CLIENT_ID=your-client-id
VITE_API_BASE_URL=http://localhost:8000
VITE_LOCAL_MODE=true
