# App mode: set to "true" to skip auth and use mock user
LOCAL_MODE=true

# Backend
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Entra ID (multi-tenant app registration)
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_TENANT_ID=your-tenant-id

# Cosmos DB
COSMOS_ENDPOINT=https://localhost:8081
COSMOS_KEY=your-cosmos-key
COSMOS_DATABASE=entra-analyzer

# Azure Cache for Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

# Azure Key Vault
KEYVAULT_URL=https://your-vault.vault.azure.net

# Microsoft Foundry (AI narratives)
AZURE_FOUNDRY_ENDPOINT=https://your-foundry.openai.azure.com
AZURE_FOUNDRY_KEY=your-foundry-key
AZURE_FOUNDRY_MODEL=gpt-4o

# Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Frontend
VITE_APP_CLIENT_ID=your-client-id
VITE_API_BASE_URL=http://localhost:8000
VITE_LOCAL_MODE=true
